{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NipCa": {
    "KeyFilePath": "/data/ca.key.enc",
    "AgentCertValidityDays": 30,
    "NodeCertValidityDays": 90,
    "RenewalWindowDays": 7,
    "NormalizeOcspResponseTime": true
  }
}
