<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NPS.NipCaServer</AssemblyName>
    <RootNamespace>NPS.NipCaServer</RootNamespace>
    <Version>1.0.0-alpha.15</Version>
    <Description>NPS NIP CA Server — standalone Docker deployable CA for issuing NID certificates.</Description>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LabAcacia.NPS.NIP"                  Version="1.0.0-alpha.15" />
    <PackageReference Include="LabAcacia.NPS.Daemon.Observability" Version="1.0.0-alpha.15" />
  </ItemGroup>

</Project>
